{
  "name": "@targon/sdk",
  "version": "4.0.0-rc.1",
  "description": "Targon SDK to interact with Targon workloads",
  "license": "Apache-2.0",
  "author": "Manifold Labs <dev@manifold.inc>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "sdk",
    "targon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/manifold-inc/targon-sdk"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
